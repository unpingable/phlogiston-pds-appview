# Template only. Installation, enablement, Caddy, DNS, TLS, and network ingress
# require a separate exact production approval.
[Unit]
Description=Phlogiston synthetic fixture renderer (not a network AppView)

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/phlogiston-appview/current/src
ExecStart=/usr/bin/python3 -m phlogiston_appview.render --snapshot /opt/phlogiston-appview/current/fixtures/synthetic-snapshot.json --output /var/lib/phlogiston-appview/rendered
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/phlogiston-appview
