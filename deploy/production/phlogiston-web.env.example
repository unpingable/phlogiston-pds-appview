PHLOGISTON_PUBLIC_URL=https://phlogiston.app
PHLOGISTON_RUNTIME_DIR=/var/lib/phlogiston
# The PCV0 kit's communitywatch-web (atproto-community deploy/public-community-pcv0); phlogiston reads it unchanged.
PHLOGISTON_PROJECTION_ORIGIN=http://127.0.0.1:8080
# Deliberately absent for inert deployment. Set at deploy time to the PCV0 kit's
# community DID (Phase 2: did:plc:b53udqv47g2dayvpstzdefpq, the Bluesky-hosted
# community actor), never to a phlogiston.social account:
# PHLOGISTON_COMMUNITY_DID=did:plc:...
