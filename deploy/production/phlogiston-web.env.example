# Not publicly routed in Phase 2 (see Caddyfile.fragment). If phlogiston-web is
# ever routed again it must be at a distinct hostname; change this value then.
PHLOGISTON_PUBLIC_URL=https://phlogiston.app
PHLOGISTON_RUNTIME_DIR=/var/lib/phlogiston
# The PCV0 kit's communitywatch-web (atproto-community deploy/public-community-pcv0); phlogiston reads it unchanged.
PHLOGISTON_PROJECTION_ORIGIN=http://127.0.0.1:8080
# Deliberately absent for inert deployment. Set at deploy time to the PCV0 kit's
# community DID (Phase 2: did:plc:b53udqv47g2dayvpstzdefpq, the Bluesky-hosted
# community actor), never to a phlogiston.social account:
# PHLOGISTON_COMMUNITY_DID=did:plc:...
# Unused in Phase 2: https://phlogiston.app itself is the community
# (community-live, PCV0 kit), so there is no separate community site to link to.
# Optional; set only if phlogiston-web is routed at a distinct hostname and
# should link to the community. Absent means no community link is shown.
# PHLOGISTON_COMMUNITY_URL=https://phlogiston.app
PORT=8092
